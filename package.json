{
  "name": "omp-agy",
  "version": "0.1.0",
  "description": "OMP extension + provider for Google Antigravity CLI (agy): persistent stream-json sessions, quota-aware model routing, honest token accounting.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build",
    "prepublishOnly": "bun run check"
  },
  "omp": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@oh-my-pi/pi-ai": "18.12.6",
    "@oh-my-pi/pi-coding-agent": "18.12.6",
    "@types/node": "^24.11.0",
    "bun-types": "^1.3.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "private": true,
  "author": "Tuan Tran",
  "homepage": "https://github.com/tuantran0910/omp-agy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuantran0910/omp-agy.git"
  },
  "bugs": {
    "url": "https://github.com/tuantran0910/omp-agy/issues"
  },
  "keywords": [
    "omp",
    "oh-my-pi",
    "agy",
    "antigravity",
    "gemini",
    "claude",
    "llm",
    "provider",
    "extension"
  ],
  "packageManager": "bun@1.3.10",
  "publishConfig": {
    "access": "public"
  }
}
